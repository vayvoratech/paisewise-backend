  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script for dynamic token validation & rotation",
          "var path = pm.request.url.getPath();",
          "var isBypassed = false;",
          "if (path) {",
          "    var pathStr = path.join('/');",
          "    if (pathStr.includes('login') || pathStr.includes('register') || pathStr.includes('refresh') || pathStr.includes('logout') || pathStr.includes('send-otp') || pathStr.includes('verify-otp')) {",
          "        isBypassed = true;",
          "    }",
          "}",
          "",
          "if (!isBypassed) {",
          "    var expiry = pm.environment.get(\"token_expiry_timestamp\");",
          "    if (expiry && Date.now() > expiry) {",
          "        console.log(\"Access token expired. Refreshing token...\");",
          "        pm.sendRequest({",
          "            url: pm.environment.get(\"base_url\") + \"/auth/refresh\",",
          "            method: \"POST\",",
          "            header: { \"Content-Type\": \"application/json\" },",
          "            body: {",
          "                mode: \"raw\",",
          "                raw: JSON.stringify({ refreshToken: pm.environment.get(\"refresh_token\") })",
          "            }",
          "        }, function (err, res) {",
          "            if (res.code === 200) {",
          "                var responseData = res.json();",
          "                pm.environment.set(\"bearer_token\", responseData.accessToken);",
          "                pm.environment.set(\"refresh_token\", responseData.refreshToken);",
          "                pm.environment.set(\"token_expiry_timestamp\", Date.now() + 900000);",
          "                console.log(\"Tokens successfully rotated in pre-request script.\");",
          "            } else {",
          "                console.error(\"Token refresh failed in pre-request script: \" + res.status);",
          "            }",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ]
